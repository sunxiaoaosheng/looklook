+
+// 在宿主启动时恢复已持久化任务；未安装技能时普通聊天仍独立工作。
+export async function resumeLooklook(router,httpRequest) {
+  const file=process.env.DSH_LOOKLOOK_ADAPTER||join(homedir(),'.agents/skills/looklook/scripts/looklook-bridge/dsh-adapter/adapter.js')
+  try { const adapter=await import(pathToFileURL(file).href); if(adapter.resumeLooklook)await adapter.resumeLooklook(router,httpRequest) }
+  catch(error){ if(error.code!=='ERR_MODULE_NOT_FOUND')router.logErr('looklook 恢复失败：',String(error)) }
+}
+export function stopLooklook(router){router.looklookHandler?.stop?.()}
