{
  "id": "looklook-mobile",
  "name": "looklook 手机入口",
  "description": "把微信或飞书的 looklook 任务交给本机执行器，并回复完整分析正文。",
  "version": "0.2.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defaultAgent": {
        "type": "string",
        "description": "工具上下文缺少 agentId 时使用的配置名，默认 main"
      },
      "agents": {
        "type": "object",
        "description": "按 agentId 隔离 looklook：未列出的 agent 不提供工具和命令",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageRoot": {
              "type": "string",
              "description": "该 agent 的视频与文本保存目录（绝对路径）"
            },
            "ytdlpCookies": {
              "type": "string",
              "description": "yt-dlp 借用的浏览器登录态，如 chrome；空字符串表示不借用"
            }
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true,
    "onCommands": [
      "looklook"
    ]
  },
  "contracts": {
    "tools": [
      "looklook_analyze"
    ]
  },
  "commandAliases": [
    {
      "name": "looklook",
      "kind": "runtime-slash"
    }
  ]
}
